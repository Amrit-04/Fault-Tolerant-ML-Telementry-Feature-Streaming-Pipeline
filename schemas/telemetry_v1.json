{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "telemetry_v1",
  "title": "ML Telemetry Event v1",
  "type": "object",
  "required": ["event_id", "entity_id", "timestamp", "feature_vector", "schema_version"],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "feature_vector": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1e6,
        "maximum": 1e6
      },
      "minItems": 8,
      "maxItems": 16
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false
}
