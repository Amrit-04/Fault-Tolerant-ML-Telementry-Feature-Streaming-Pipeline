{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "ML Telemetry Pipeline — end-to-end observability",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "rate(validator_events_consumed_total[1m])",
          "legendFormat": "consumed (raw)",
          "refId": "A"
        },
        {
          "expr": "rate(validator_validated_total[1m])",
          "legendFormat": "validated",
          "refId": "B"
        },
        {
          "expr": "rate(validator_rejected_total[1m])",
          "legendFormat": "rejected (DLQ)",
          "refId": "C"
        },
        {
          "expr": "rate(writer_writes_total[1m])",
          "legendFormat": "written to DB",
          "refId": "D"
        }
      ],
      "title": "Events/sec — Pipeline Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (topic, partition) (kafka_topic_partition_current_offset - kafka_consumergroup_current_offset)",
          "legendFormat": "{{topic}} p{{partition}}",
          "refId": "A"
        }
      ],
      "title": "Consumer Lag per Partition",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Validation",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 10 },
      "id": 3,
      "targets": [
        {
          "expr": "rate(validator_rejected_total[5m]) / (rate(validator_validated_total[5m]) + rate(validator_rejected_total[5m]) + 0.001)",
          "legendFormat": "Reject Rate",
          "refId": "A"
        }
      ],
      "title": "Validation Reject Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 10 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(validator_validation_latency_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(validator_validation_latency_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "title": "Validation Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 10 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(kafka_topic_partition_current_offset{topic=\"telemetry.dlq\"})",
          "legendFormat": "DLQ Depth",
          "refId": "A"
        }
      ],
      "title": "DLQ Depth",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 102,
      "title": "Feature Writer",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 18 },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(writer_write_latency_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(writer_write_latency_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(writer_write_latency_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "DB Write Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 18 },
      "id": 7,
      "targets": [
        {
          "expr": "rate(writer_errors_total[5m])",
          "legendFormat": "errors/sec ({{target}})",
          "refId": "A"
        },
        {
          "expr": "rate(writer_duplicates_skipped_total[5m])",
          "legendFormat": "duplicates skipped/sec",
          "refId": "B"
        }
      ],
      "title": "Writer Errors & Duplicates",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 103,
      "title": "API — Feature Serving",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 8,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(api_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p50 {{endpoint}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(api_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p95 {{endpoint}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(api_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p99 {{endpoint}}",
          "refId": "C"
        }
      ],
      "title": "API Latency p50/p95/p99",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 9,
      "targets": [
        {
          "expr": "rate(api_cache_hits_total[5m]) / (rate(api_cache_hits_total[5m]) + rate(api_cache_misses_total[5m]) + 0.001)",
          "legendFormat": "Cache Hit Ratio",
          "refId": "A"
        }
      ],
      "title": "Redis Cache Hit Ratio",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 104,
      "title": "Infrastructure",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 35 },
      "id": 10,
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Redis Memory Used",
          "refId": "A"
        }
      ],
      "title": "Redis Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 35 },
      "id": 11,
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "PG Active Connections",
          "refId": "A"
        }
      ],
      "title": "Postgres Active Connections",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 35 },
      "id": 12,
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_inserted{datname=\"pipeline\"}[1m])",
          "legendFormat": "Rows Inserted/sec",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_tup_fetched{datname=\"pipeline\"}[1m])",
          "legendFormat": "Rows Fetched/sec",
          "refId": "B"
        }
      ],
      "title": "Postgres Throughput",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["pipeline", "kafka", "ml"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ML Telemetry Pipeline",
  "uid": "ml-telemetry-pipeline",
  "version": 1
}
