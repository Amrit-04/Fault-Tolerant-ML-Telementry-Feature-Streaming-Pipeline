# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PARTITIONS=12
KAFKA_DLQ_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# PostgreSQL
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_DB=pipeline
POSTGRES_DSN=postgresql://pipeline:pipeline@postgres:5432/pipeline

# Redis
REDIS_URL=redis://redis:6379/0

# Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Producer
PRODUCER_RATE=10000
PRODUCER_DURATION=60
PRODUCER_MALFORMED_PCT=0
PRODUCER_ENTITY_CARDINALITY=100000
PRODUCER_BURST_MULTIPLIER=1.0
PRODUCER_NUM_FEATURES=10

# Writer
WRITER_BATCH_SIZE=500
WRITER_MAX_POLL_RECORDS=1000

# Validator
VALIDATOR_MAX_POLL_RECORDS=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
